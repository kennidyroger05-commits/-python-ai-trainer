{
 "name": "python-ai-trainer-staging",
 "main": "worker.mjs",
 "compatibility_date": "2026-11-25",
 "vars": {"AUTH_EMAIL_ENABLED":"false"},
 "ratelimits": [{"name":"AUTH_LIMITER","namespace_id":"1001","simple":{"limit":10,"period":60}}],
 "assets": {"directory":"./dist","binding":"ASSETS","run_worker_first":true,"html_handling":"none","not_found_handling":"none"}
}